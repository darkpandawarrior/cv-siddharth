  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen:galleries": "node scripts/gen-galleries.mjs",
    "sync:media": "node scripts/sync-project-media.mjs",
    "gen:stats": "node scripts/gen-project-stats.mjs",
    "gen:hiresignal": "node scripts/gen-hiresignal-stats.mjs",
