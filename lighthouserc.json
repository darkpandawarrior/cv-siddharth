{
  "ci": {
    "collect": {
      "startServerCommand": "npm run serve",
      "url": ["http://localhost:4173/", "http://localhost:4173/resume", "http://localhost:4173/project/mileway", "http://localhost:4173/lab", "http://localhost:4173/blueprint", "http://localhost:4173/chess"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3500 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 3500000 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 1800000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
