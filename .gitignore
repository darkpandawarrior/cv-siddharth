node_modules
dist
.env.local
.env*.local
# Timestamped backups written by AgentHarness/scripts/rotate-api-key.sh. These
# CONTAIN THE OLD SECRET, and `.env*.local` does NOT match them — the pattern
# requires the name to end in `.local`, while these end in `.bak`. Without this
# line a `git add -A` would commit a rotated-out API key.
*.bak
.env*.bak
*.log
.DS_Store
.vercel
.showcase-work/

# build-time image derivatives (scripts/gen-images.mjs, regenerated in prebuild)
public/**/*.avif
public/**/*.webp
# heavy/ (screenshots, showcase posters, Excelsior covers — moved off Vercel
# onto GitHub Pages, see src/lib/assetBase.ts) gets the same derivatives, same
# reason: regenerated in prebuild, never carried in git.
heavy/**/*.avif
heavy/**/*.webp
# ...except the Excelsior magazine pages. Those are NOT derivatives — they are
# the source, rendered from PDFs that do not live in this repo by the manual
# scripts/gen-excelsior.mjs. Ignoring them would silently ship a reader with no
# pages in it. gen-images.mjs skips this directory for the same reason.
!public/excelsior/pages/**/*.webp
!heavy/excelsior/pages/**/*.webp
# ...and except GLOBE's static no-WebGL plates (scripts/capture-globe-plate.mjs,
# P2-10b): a manual capture of the live scene, not a derivative gen-images.mjs
# would ever create from a PNG sibling in this repo. Ignoring them ships a
# no-WebGL /globe visitor a fact list with no image beside it.
!heavy/globe/plates/*.avif
# ...and except the world-v2 concept-art frames. Same reasoning again: they are
# not derivatives of anything in this repo, they are the source paintings
# (gemini-3-pro-image, packed by scripts/world-v2/pack-concept.mjs from the
# gitignored .showcase-work/concept/ PNGs, which are never committed).
# Ignoring them ships a playground fallback and share preview with no image.
# NOTE: 01-golden-spawn-og.jpg is real source too (the share-preview crop),
# but gen-images.mjs walks heavy/ and bakes it its own .webp/.avif sibling
# derivative at build time — that one IS regenerable, so it stays re-ignored
# below (order matters: a later negated pattern wins).
!heavy/world/concept/**/*.webp
heavy/world/concept/*-og.webp
# ...and except this lane's own flow-map bake (scripts/world-v2/gen-terrain.mjs,
# P2-05): it is the canonical output of a generator reading real committed
# data (river/tributary tangents, the confluence collar), not a derivative
# gen-images.mjs would ever create from a PNG sibling — there is no
# valley-flow-1024.png. Ignoring it ships terrain with no real flow map.
!heavy/world/terrain/valley-flow-1024.webp
# ...and except the Play Store icons. Same reasoning: not derivatives of
# anything in this repo. scripts/gen-store.mjs downloads them from the live
# listings, and it needs the private Jugnoo repos to run, which a build machine
# does not have. Ignoring them ships a shelf of blank squares.
!public/store/*.webp
# ...and except the surface posters. Same reasoning again: scripts/gen-surfaces.mjs
# derives them from docs/screenshots/, which scripts/capture-site.mjs fills by
# driving a real browser over a running dev server — neither of which a build
# machine has. Ignoring them fails surfaces.test.ts on a fresh clone and ships
# a homepage wall of empty frames.
!public/surfaces/*.webp
# ...and once more for the README's wall capture. Same reasoning as all three
# above: it is a screenshot of the LIVE site taken by driving a real browser,
# not a derivative of any source in this repo, so gen-images.mjs has nothing to
# regenerate it from. Ignoring it ships a README whose main illustration 404s on
# GitHub — which is exactly the state this rule was written to prevent.
!public/assets/readme/*.webp
# ...and except the Loopdown cast portraits and series covers. Same reasoning
# again: they are not derivatives of anything in this repo — scripts/gen-
# loopdown-art.mjs fetches the-loopdown's own pre-optimized .webp files over
# the network (raw.githubusercontent.com), it does not encode them from a
# local .png sibling the way gen-images.mjs would. Ignoring them ships a
# bestiary and a set of series headers with no art in them.
!heavy/loopdown/**/*.webp

# Playwright output
test-results/
playwright-report/

# Lighthouse CI output
.lighthouseci/

# chess corpus cache (scripts/gen-chess-stats.mjs) — the lichess half is a
# frozen archive (last activity 2025-01-16) and its full NDJSON export takes
# ~9 minutes, so it is fetched once and cached rather than re-pulled daily.
.chess-cache/
.excelsior-cache/
# AniList lookups for the Weeb Central corpus (scripts/gen-weeb.mjs). 176 calls
# at ~1/sec; cached so a rerun after editing the CSVs costs no network.
.weeb-cache/

# Code knowledge graph (graphify). Derived, rebuildable, and large; it also mirrors every
# symbol name in the repo, so it is never committed. Rebuild: node ~/Tools/DevTools/AgentHarness/scripts/graph.mjs build
graphify-out/

# Play Store probe cache for scripts/gen-store.mjs — regenerable, and large.
.store-cache.json
.store-archive-cache.json
.store-since-cache.json
.store-flavours.json
.store-siblings.json

# piper voice models — ~61MB of weights, re-fetchable from the same URL the
# script derives. Same rule as the avif/webp block above: regenerable, not carried.
.piper-voices/

# Raw Poly Haven model downloads (scripts/blender/world-v2/fetch-polyhaven-models.py)
# — source jpg/gltf/bin for the lookdev scatter kit (fern/shrub/rock/lantern).
# Same regenerable-input rule as heavy/**/*.webp above; the CC0 attribution
# that IS carried lives in heavy/world/ASSETS.md, and the baked lookdev
# render + exported landmark GLBs are committed separately.
heavy/world/models/polyhaven/

# Blender's bytecode cache for the world-v2 kit scripts (scripts/blender/world-v2/*.py).
__pycache__/
