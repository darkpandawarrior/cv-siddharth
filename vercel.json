{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "redirects": [
    { "source": "/p/resume", "destination": "/resume", "permanent": true },
    { "source": "/p/writing", "destination": "/loopdown", "permanent": true },
    { "source": "/p/:slug", "destination": "/project/:slug", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/kursi-app/(.*)\\.wasm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/paymentslab-app/(.*)\\.wasm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/mileway-app/(.*)\\.wasm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
