# Sid chatbot — set ANY ONE of these keys. Priority: Groq → Gemini → Anthropic.
# Without a key the site still works; the chat widget shows a contact fallback.

# Groq (recommended, free, no credit card) — console.groq.com
GROQ_API_KEY=

# Google Gemini (free tier) — aistudio.google.com
GEMINI_API_KEY=

# Anthropic Claude — console.anthropic.com
# Cerebras. Fully wired as the second provider in the fallback order and
# covered by tests, but it was missing from this file, so anyone setting the
# project up never knew it was an option.
CEREBRAS_API_KEY=

ANTHROPIC_API_KEY=

# Optional overrides
# CHAT_PROVIDER=groq            # force a provider when multiple keys are set
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# CEREBRAS_MODEL=llama-3.3-70b
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Abuse guards (api/_lib/chat-handler.ts). The endpoint spends YOUR key, so it
# only answers browsers on an allowed origin, and only so often per IP.
# Allowed out of the box: https://cv-siddharth.vercel.app, this deployment's own
# Vercel hostnames (VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL,
# i.e. previews), and localhost. A request with no Origin header is refused.
# ALLOWED_ORIGIN=https://darkpandawarrior.github.io   # extra origin(s), comma-separated
# CHAT_RATE_PER_MIN=10          # per client IP
# CHAT_RATE_PER_HOUR=60         # per client IP

# Spotify "now playing" widget — optional. Create a free app at
# developer.spotify.com/dashboard, then run `npm run spotify:auth` once to
# get SPOTIFY_REFRESH_TOKEN. Without these, the widget shows "not connected".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# GitHub activity widget — optional, works keyless. Set this only to raise
# the rate ceiling (same token/reasoning refresh-media.yml already uses).
GITHUB_TOKEN=

# tldraw licence — REQUIRED for the Blueprint Room's Sketch mode in production.
# Since tldraw v4 an unlicensed non-localhost deploy renders the whiteboard for
# five seconds and then blanks it (LicenseProvider's LICENSE_TIMEOUT). localhost
# is exempt, so this is invisible in dev, in `vite preview` and in CI. Without a
# key the room detects this and offers Sketch disabled with the reason instead of
# handing over a canvas that dies. Free hobby licence: tldraw.dev/get-a-license/hobby
#
# Do not paste a key straight in here. `node scripts/tldraw-key.mjs --apply <key>`
# verifies the signature and the expiry and the domain scope FIRST, then writes
# this file and both Vercel targets — an expired or wrong-domain key costs a
# 9-minute build to discover, because tldraw only enforces any of it on https.
VITE_TLDRAW_LICENSE_KEY=

# Set to "off" to remove the Playground's guest wall on the next deploy — the
# kill switch for the one surface where visitors' own words are shown to others.
# VITE_GUEST_WALL=off
