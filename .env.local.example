# Sid chatbot — set ANY ONE of these keys. Priority: Groq → Gemini → Anthropic.
# Without a key the site still works; the chat widget shows a contact fallback.

# Groq (recommended, free, no credit card) — console.groq.com
GROQ_API_KEY=

# Google Gemini (free tier) — aistudio.google.com
GEMINI_API_KEY=

# Anthropic Claude — console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# CHAT_PROVIDER=groq            # force a provider when multiple keys are set
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Abuse guards (api/_lib/chat-handler.ts). The endpoint spends YOUR key, so it
# only answers browsers on an allowed origin, and only so often per IP.
# Allowed out of the box: https://cv-siddharth.vercel.app, this deployment's own
# Vercel hostnames (VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL,
# i.e. previews), and localhost. A request with no Origin header is refused.
# ALLOWED_ORIGIN=https://darkpandawarrior.github.io   # extra origin(s), comma-separated
# CHAT_RATE_PER_MIN=10          # per client IP
# CHAT_RATE_PER_HOUR=60         # per client IP
